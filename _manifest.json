{
  "manifest_version": 2,
  "id": "github.haoxiangxia.omp-agent",
  "plugin_type": "tool",
  "version": "1.2.0",
  "name": "OMP Agent 插件",
  "description": "提供 /omp 显式指令直通调用宿主机 OMP 执行代码与开发任务，内置 RPC-UI 流式双向交互、Bubblewrap 沙盒隔离、原生扩展状态监听与 QQ 原生卡片回传",
  "author": {
    "name": "HaoxiangXia",
    "url": "https://github.com/HaoxiangXia"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/HaoxiangXia/maibot-omp-plugin",
    "homepage": "https://github.com/HaoxiangXia/maibot-omp-plugin",
    "documentation": "https://github.com/HaoxiangXia/maibot-omp-plugin/blob/main/README.md",
    "issues": "https://github.com/HaoxiangXia/maibot-omp-plugin/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
